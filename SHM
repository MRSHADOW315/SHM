<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>عالم شام | ليلة ميلاد الاستثناء</title>
<link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cairo:wght@600;700;800&family=Reem+Kufi:wght@500;700&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<style>
  :root { --bg-dark: #0a0713; --card-bg: rgba(18, 13, 31, 0.8); --gold: #f5d061; --rose-pink: #ff9ebb; --soft-white: #f0f4f8; --border-glow: rgba(255, 158, 187, 0.3); }
  * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
  body { font-family: 'Amiri', serif; background-color: var(--bg-dark); color: var(--soft-white); height: 100vh; width: 100vw; overflow: hidden; position: relative; }
  #starfield { position: fixed; inset: 0; z-index: 1; pointer-events: none; }
  .app-viewport { position: relative; z-index: 10; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: space-between; padding: 10px; }
  .glass-panel { background: var(--card-bg); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid var(--border-glow); box-shadow: 0 15px 35px rgba(0,0,0,0.6); }
  .top-bar { padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; }
  .progress-bar-container { flex: 1; height: 6px; background: rgba(255, 255, 255, 0.1); border-radius: 10px; margin: 0 15px; overflow: hidden; }
  .progress-bar-fill { height: 100%; background: linear-gradient(90deg, var(--rose-pink), var(--gold)); width: 0%; transition: width 0.4s ease; }
  .slides-container { position: relative; flex: 1; width: 100%; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .slide-card { position: absolute; width: 100%; max-width: 420px; height: 100%; max-height: 600px; border-radius: 28px; padding: 24px 20px; display: flex; flex-direction: column; justify-content: space-between; align-items: center; opacity: 0; transform: scale(0.92) translateY(20px); transition: all 0.5s ease; pointer-events: none; }
  .slide-card.active { opacity: 1; transform: scale(1) translateY(0); pointer-events: auto; }
  .slide-image-box { width: 100%; height: 220px; border-radius: 20px; overflow: hidden; border: 1.5px solid rgba(245, 208, 97, 0.3); background: rgba(0,0,0,0.4); }
  .slide-image-box img { width: 100%; height: 100%; object-fit: cover; }
  .tag { font-family: 'Cairo', sans-serif; font-size: 0.75rem; font-weight: 700; color: var(--rose-pink); background: rgba(255, 158, 187, 0.12); padding: 4px 14px; border-radius: 20px; border: 1px solid rgba(255, 158, 187, 0.25); }
  .slide-title { font-family: 'Reem Kufi', sans-serif; font-size: 1.6rem; color: var(--gold); line-height: 1.3; }
  .slide-prose { font-family: 'Amiri', serif; font-size: 1.15rem; line-height: 1.9; color: var(--soft-white); text-align: center; }
  .bottom-bar { padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; }
  .btn-circle { width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.06); border: 1px solid var(--border-glow); color: var(--soft-white); font-size: 1.2rem; }
  .start-overlay { position: fixed; inset: 0; background: rgba(10, 7, 19, 0.96); z-index: 200; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 24px; text-align: center; }
</style>
</head>
<body>
<canvas id="starfield"></canvas>
<audio id="bgAudio" src="data:audio/mpeg;base64," loop></audio>

<div class="start-overlay" id="startOverlay">
  <div class="w-20 h-20 rounded-full bg-pink-500/10 border border-pink-400/30 flex items-center justify-center mb-6 animate-pulse">
    <span class="text-3xl">✨</span>
  </div>
  <h1 class="font-['Reem_Kufi'] text-3xl text-[#f5d061] mb-2">عالم شام الصغير</h1>
  <p class="font-['Cairo'] text-gray-300 text-sm mb-8">هدية ليلة ميلاد الاستثناء</p>
  <button class="bg-gradient-to-r from-pink-400 to-yellow-400 text-black font-['Cairo'] font-bold py-4 px-8 rounded-full text-lg shadow-lg" onclick="startApp()">دخول العرض 🎵</button>
</div>

<div class="app-viewport">
  <div class="top-bar glass-panel rounded-full mx-4 mt-2">
    <span class="font-['Cairo'] text-xs text-[#f5d061]">✨ عالم شام</span>
    <div class="progress-bar-container"><div class="progress-bar-fill" id="progressFill"></div></div>
    <div class="font-['Cairo'] text-xs text-[#ff9ebb]" id="slideCounter">1 / 10</div>
  </div>

  <div class="slides-container" id="slidesContainer" touchstart="handleTouchStart(event)" touchend="handleTouchEnd(event)"></div>

  <div class="bottom-bar glass-panel rounded-full mx-4 mb-2">
    <button class="btn-circle" id="prevBtn" onclick="prevSlide()">➔</button>
    <button class="btn-circle text-pink-300" onclick="toggleAudio()"><span id="audioIcon">🎵</span></button>
    <button class="btn-circle" id="nextBtn" onclick="nextSlide()">⬅</button>
  </div>
</div>

<script>
  const slidesData = [{"id":1,"tag":"مقام الروح","title":"تحت سماء اكتمال القمر","prose":"في هذه الليلة، لا تُقاس الأيام بالساعات بل ببهاء وجودكِ. كأن القمر الساطع في السماء قد استمد نوره من صفاء قلبكِ، وكأن الكون بأكمله يلتف حولنا ليحتفي بليلة ميلاد الاستثناء.","image":"data:image/jpeg;base64,"},{"id":2,"tag":"دفء المودة","title":"عالم من اللطافة والتفاصيل","prose":"كل لحظة معكِ تبدو كعناق دافئ في يوم بارد. أنتِ التفاصيل الصغيرة التي تمنح الحياة حلاوتها، والضحكة الناعمة التي ترمم كل تعب، والقلب الذي يفيض بحنان نقي.","image":"data:image/png;base64,"},{"id":3,"tag":"إكليل الزهر","title":"أمانٌ وسط كل شيء","prose":"حتى وإن تساقطت أوراق الأيام أو اشتدت برودة الأوقات، يظل وجودكِ كإكليل من الورد يزهر في القلب. أن تكوني هنا يعني أن الأمن والسكينة دائماً بمتناول اليد.","image":"data:image/jpeg;base64,"},{"id":4,"tag":"دعاء وورود","title":"أمنيات لعامكِ الجديد","prose":"أتمنى لكِ عاماً يزهر بالنور، تتفتح فيه أمانيكِ الكبيرة قبل الصغيرة. أدعو أن تظل ابتسامتكِ مشرقة لا يمسها حزن، وأن تحققي كل حلم تتطلع إليه روحكِ الجميلة.","image":"data:image/png;base64,"},{"id":1793072366433,"tag":"قبانو","title":"لطافة لا تُقاوم","prose":"\"مثل هذا الأرنب تماماً.. قلبكِ يملأ الدنيا دفئاً ولطافة، وهات أحلى بوسة يا أغلى شام!\"","image":"data:image/jpeg;base64,"},{"id":1793073399107,"tag":"القعدة الدافئة","title":"دفء الأيام بقربك","prose":"\"أحلى الأوقات وأدفأ اللحظات جنبِك.. دمتِ لي الأمان والضحكة اللي بتنور أيامي.\"","image":"data:image/jpeg;base64,"},{"id":1793073403801,"tag":"تحت النجوم","title":"رحلتنا بين النجوم","prose":"\"سوا بِنعبر عوالم وبنطير بين السحاب والنجوم، معكِ أحلى لحظات العمر يا أجمل حكاية.\"","image":"data:image/jpeg;base64,"},{"id":1793073404088,"tag":"وقت غروب الشمس","title":"قصة مختلفة وعالم خاص","prose":"\"مهما كانت العوالم مختلفة، نبقى أنا وأنتِ القصة الأجمل في كل أفق وغروب.\"","image":"data:image/jpeg;base64,"},{"id":1793073404391,"tag":"الوردي","title":"Love You Sooo Much","prose":"\"بحبك قد الكون وما فيه.. يا أجمل ما صار في عمري يا شمشومي و يا شام الروح والقلب.\"","image":"data:image/jpeg;base64,"},{"id":5,"tag":"خاتمة المحبة","title":"كل عام وأنتِ الاستثناء يا شام","prose":"دُمتِ لي شيئاً جميلاً لا ينتهي، ودامت أيامكِ مليئة بالبهجة والسلام. عيد ميلاد سعيد لِروحٍ أضافت للعالم معنى أعمق للجمال والدفء. 👑✨","image":"data:image/jpeg;base64,"}];
  let currentSlideIndex = 0, isPlayingAudio = false, touchStartX = 0, touchEndX = 0;

  window.onload = () => { initStarfieldCanvas(); renderSlides(); updateUI(); };

  function renderSlides() {
    const container = document.getElementById('slidesContainer');
    container.innerHTML = '';
    slidesData.forEach((s, idx) => {
      const el = document.createElement('div');
      el.className = `slide-card glass-panel ${idx === currentSlideIndex ? 'active' : ''}`;
      el.innerHTML = `<span class="tag">${s.tag}</span>${s.image ? `<div class="slide-image-box my-3"><img src="${s.image}"></div>` : ''}<div class="flex-1 flex flex-col justify-center my-2"><h2 class="slide-title mb-3">${s.title}</h2><p class="slide-prose">${s.prose}</p></div>`;
      container.appendChild(el);
    });
  }

  function updateUI() {
    const total = slidesData.length;
    document.getElementById('progressFill').style.width = `${((currentSlideIndex + 1) / total) * 100}%`;
    document.getElementById('slideCounter').innerText = `${currentSlideIndex + 1} / ${total}`;
    document.querySelectorAll('.slide-card').forEach((c, idx) => c.classList.toggle('active', idx === currentSlideIndex));
    document.getElementById('prevBtn').disabled = (currentSlideIndex === 0);
    document.getElementById('nextBtn').disabled = (currentSlideIndex === total - 1);
  }

  function nextSlide() { if (currentSlideIndex < slidesData.length - 1) { currentSlideIndex++; updateUI(); } }
  function prevSlide() { if (currentSlideIndex > 0) { currentSlideIndex--; updateUI(); } }
  function handleTouchStart(e) { touchStartX = e.changedTouches[0].screenX; }
  function handleTouchEnd(e) { touchEndX = e.changedTouches[0].screenX; if (Math.abs(touchEndX - touchStartX) > 40) { if (touchEndX - touchStartX < 0) nextSlide(); else prevSlide(); } }
  
  function startApp() {
    document.getElementById('startOverlay').style.display = 'none';
    const audio = document.getElementById('bgAudio');
    if (audio.src) audio.play().then(() => { isPlayingAudio = true; }).catch(e=>console.log(e));
  }

  function toggleAudio() {
    const audio = document.getElementById('bgAudio');
    if (!audio.src) return;
    if (isPlayingAudio) { audio.pause(); isPlayingAudio = false; }
    else { audio.play(); isPlayingAudio = true; }
  }

  function initStarfieldCanvas() {
    const canvas = document.getElementById('starfield'); const ctx = canvas.getContext('2d');
    let width = canvas.width = window.innerWidth, height = canvas.height = window.innerHeight;
    const stars = Array.from({ length: 60 }, () => ({ x: Math.random() * width, y: Math.random() * height, size: Math.random() * 2, alpha: Math.random(), speed: 0.01 }));
    function draw() {
      ctx.clearRect(0, 0, width, height);
      stars.forEach(s => { s.alpha += s.speed; if (s.alpha > 1 || s.alpha < 0) s.speed = -s.speed; ctx.fillStyle = `rgba(255,255,255,${Math.abs(s.alpha)})`; ctx.beginPath(); ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2); ctx.fill(); });
      requestAnimationFrame(draw);
    }
    draw();
  }
</script>
</body>
</html>
